# Copiá a .env.local (local) o a las variables de entorno de Vercel.

# LLM (OpenRouter u otro compatible con OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_FALLBACK_MODEL=
DEBATE_MAX_TOKENS=4000

# Base de datos principal (debates, historial) — Prisma
DATABASE_URL=

# Base de conocimiento: vectores en Neon (pgvector)
KNOWLEDGE_DATABASE_URL=

# Embeddings: elegí un proveedor
# a) Neon AI Gateway (plan pago + créditos), modelo qwen3-embedding-0-6b
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=
# b) OpenAI u otro compatible, modelo text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Opcionales
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GRAPHDB_ENDPOINT_URL=
