# Copiá a .env.local (local) o a las variables de entorno de Vercel.

# LLM (OpenRouter u otro compatible con OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_FALLBACK_MODEL=
DEBATE_MAX_TOKENS=4000

# Base de datos principal (debates, historial) — Prisma
DATABASE_URL=

# Base de conocimiento: vectores en Neon (pgvector)
KNOWLEDGE_DATABASE_URL=

# Embeddings: elegí un proveedor (o fijalo con EMBEDDING_PROVIDER=gemini|jina|openrouter|openai-compatible|neon-ai-gateway)
# Gratis: Google Gemini (gemini-embedding-001) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gratis (10M tokens, uso no comercial): Jina AI — https://jina.ai/embeddings
JINA_API_KEY=
# Pago: OpenRouter (EMBEDDING_PROVIDER=openrouter, reusa OPENROUTER_API_KEY), OpenAI u otro compatible, Neon AI Gateway
EMBEDDING_PROVIDER=
OPENROUTER_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=

# Opcionales
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GRAPHDB_ENDPOINT_URL=
